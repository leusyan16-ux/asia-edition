# Safe local assessment: read-only bundled catalogue, no external services.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
TOUR_DATA_SOURCE=static
PUBLIC_PREVIEW_ONLY=true
ADMIN_MODE=disabled
SITE_INDEXING_ENABLED=false
COMMERCE_ENABLED=false
COMMERCE_GOOGLE_ENABLED=false
INQUIRIES_ENABLED=false
PRIVATE_STORAGE_ENABLED=false
POSTGRES_REMOTE_ENABLED=false
POSTGRES_LOCAL_WORKER=off

# Optional local inventory development (never a production database).
# ADMIN_MODE=local
# TOUR_DATA_SOURCE=local
# PUBLIC_PREVIEW_ONLY=false
# Local credentials are created with pnpm admin:setup, not stored in this file.
# PostgreSQL/PGlite options: docs/POSTGRES_LOCAL_INTEGRATION.md

# External integration is opt-in. Leave all credentials blank for assessment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never use NEXT_PUBLIC_ for these values.
COMMERCE_TELEGRAM_SUPABASE_SECRET=
COMMERCE_TELEGRAM_BOT_TOKEN=
COMMERCE_TELEGRAM_CHAT_ID=
COMMERCE_TELEGRAM_CRON_SECRET=
# Isolated staging only; requires the matching project and approved origin.
COMMERCE_ENVIRONMENT=staging
COMMERCE_STAGING_PROJECT_REF=
